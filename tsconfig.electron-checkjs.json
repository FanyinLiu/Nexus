{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "electron/ipc/**/*.js",
    "electron/services/keyVault.js",
    "electron/services/localDataStore.js",
    "electron/services/localDataStoreCore.js",
    "electron/chatRuntime.js",
    "electron/services/reminderStrip.js",
    "electron/services/reminderStripQueue.js"
  ]
}
